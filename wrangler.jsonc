{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "seiseisai-archives",
    "main": "./_worker.js",
    "compatibility_date": "2026-10-26",
    "workers_dev": false,
    "preview_urls": false,
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/20*"],
        "not_found_handling": "404-page"
    }
}
